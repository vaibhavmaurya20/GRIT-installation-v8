// Find prime numbers up to N
fn is_prime n:int -> int
    if n < 2
        return 0
    let mut i = 2
    while i * i <= n
        if n % i == 0
            return 0
        i += 1
    1

fn main
    let mut i = 2
    let mut count = 0
    while i <= 50
        if is_prime(i)
            println(i)
            count += 1
        i += 1
    println(count)
